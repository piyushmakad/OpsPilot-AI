{
  "name": "@opspilot/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/eval-metrics.test.ts src/knowledge-chunk.test.ts src/retrieval.test.ts src/engine.test.ts src/workflow.test.ts src/memory.test.ts src/context-preview.test.ts src/memory-extraction.test.ts src/context-builder.test.ts src/context-service.test.ts",
    "test:db": "node --import tsx --test src/retrieval.db.test.ts src/workflow.db.test.ts src/memory.db.test.ts",
    "eval": "tsx src/cli.ts eval retrieval",
    "eval:check": "tsx src/cli.ts eval retrieval --check",
    "eval:answers": "tsx src/cli.ts eval answers --judge"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@opspilot/shared": "*",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
