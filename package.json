{
  "name": "opspilot-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w @opspilot/server dev --",
    "ui:dev": "npm run -w @opspilot/web dev",
    "test": "npm run -w @opspilot/server test",
    "test:db": "npm run -w @opspilot/server test:db",
    "eval": "npm run -w @opspilot/server eval --",
    "eval:check": "npm run -w @opspilot/server eval:check",
    "eval:answers": "npm run -w @opspilot/server eval:answers",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run typecheck && npm run -w @opspilot/web build",
    "start": "npm run -w @opspilot/server start --"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
